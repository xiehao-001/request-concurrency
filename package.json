{
  "name": "@eduwork/dsh-request-concurrency",
  "version": "0.1.0-dev",
  "description": "Global FIFO queue capping concurrent model requests across sessions, subagents and workflows.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "exports": {
    ".": "./lib/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "MARKET.md",
    "docs/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "concurrency",
    "queue",
    "rate-limit",
    "llm"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  }
}
